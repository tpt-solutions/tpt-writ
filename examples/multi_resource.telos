// Phase 4 fixture: demonstrates every ResourceAwareDerivation outcome
// against real, verified .telos functions.
//
//   peek_sender    -> Read{"db:senders"}     (single tagged class, read-only)
//   bump_sender    -> Write{"db:senders"}    (single tagged class, written)
//   transfer       -> Write{"*"}             (touches two tagged classes)
//   audit          -> Write{"*"}             (touches an untagged invariant)
//
// Verified: `writ verify examples/multi_resource.telos`

module Bank {
    @resource(class = "db:senders") invariant Sender { balance >= 0 }
    @resource(class = "db:receivers") invariant Receiver { balance >= 0 }

    // Untagged on purpose: exercises ResourceAwareDerivation's fallback for
    // state with no declared resource class at all.
    invariant Ledger { total >= 0 }

    func peek_sender(s: Sender)
    ;

    func bump_sender(s: Sender, amount: PositiveInt)
        ensures s.balance == old(s.balance) + amount
    ;

    func transfer(mut sender: Sender, mut receiver: Receiver, amount: i64)
        requires amount > 0
        requires sender.balance >= amount
        requires receiver.balance + amount >= 0
        ensures sender.balance == old(sender.balance) - amount
        ensures receiver.balance == old(receiver.balance) + amount
    {
        mutate state {
            sender.balance = old(sender.balance) - amount;
            receiver.balance = old(receiver.balance) + amount;
        }
    }

    func audit(l: Ledger)
    ;
}
